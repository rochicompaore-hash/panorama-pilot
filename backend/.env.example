# Infissi Express Cloud — Backend environment example
# Copy to .env and fill values. NEVER commit .env with real secrets.

# --- MongoDB ---
MONGO_URL="mongodb://localhost:27017"
DB_NAME="infissi_express"

# --- JWT / Auth ---
JWT_SECRET="change-this-in-production-with-a-long-random-string"
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14

# --- CORS ---
CORS_ORIGINS="*"

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=25

# --- Object Storage (Emergent-managed S3 compatible) ---
EMERGENT_LLM_KEY="sk-emergent-xxxxxxxxxxxx"
APP_STORAGE_PREFIX="infissi-express"

# --- Environment gate (development | test | staging | production) ---
APP_ENV="development"

# --- Redis (MANDATORY in staging/production for OTP/signature) ---
# Empty in dev = in-memory fallback allowed.
REDIS_URL="redis://127.0.0.1:6379/0"

# --- Rate limits (configurable, sane defaults) ---
RATE_LIMIT_LINK_OPEN_PER_MIN=30
RATE_LIMIT_PDF_DOWNLOAD_PER_MIN=10
RATE_LIMIT_OTP_REQUEST_WINDOW_SEC=600
RATE_LIMIT_OTP_REQUEST_MAX=3
RATE_LIMIT_OTP_REQUEST_COOLDOWN_SEC=60
RATE_LIMIT_OTP_REQUEST_DAILY_MAX=10
RATE_LIMIT_OTP_VERIFY_MAX_ATTEMPTS=5
RATE_LIMIT_OTP_VERIFY_DAILY_MAX_FAIL=20
RATE_LIMIT_SIGN_PER_HOUR=5

# --- OTP ---
OTP_TTL_SECONDS=600
OTP_LENGTH=6
# ⚠️ MUST BE FALSE IN PRODUCTION
OTP_DEBUG_ENABLED=true

# --- Signature ---
SIGNATURE_EVIDENCE_ISSUER="Infissi Express Cloud"

# --- Platform Owner (proprietario globale) ---
# Email dell'utenza proprietaria. Non hardcoded, non tenant-scoped, non eliminabile.
# Al primo avvio in dev: recupera l'invito via GET /api/debug/platform-owner-invite
PLATFORM_OWNER_EMAIL="rochicompaore@gmail.com"

# --- Public portal degradation policy ---
# When true and Redis down in prod, the public read-only view remains available; sensitive actions (OTP/sign) always fail-closed.
DEGRADED_PUBLIC_VIEW_ALLOWED=true

# --- Email provider (Resend) — configure in production ---
# RESEND_API_KEY="re_..."
# RESEND_FROM="Infissi Express <no-reply@infissiexpress.com>"

# --- WhatsApp provider (Twilio or Meta Cloud) — optional ---
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_WA_FROM="whatsapp:+1234567890"
